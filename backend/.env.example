NODE_ENV=development
PORT=3001
FRONTEND_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5173
# Empty uses persistent embedded PostgreSQL in ./data/postgres.
DATABASE_URL=
# Set independent random secrets (at least 32 characters) outside local development.
JWT_SECRET=
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=false
# Production requires HTTPS, COOKIE_SECURE=true and an SMS delivery adapter URL/token.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
